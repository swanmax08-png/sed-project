        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam class {\n    BackgroundColor White\n    ArrowColor #2C3E50\n    BorderColor #2C3E50\n}\n\nclass Клиент {\n  - id: int\n  - ФИО: string\n  - телефон: string\n  + зарегистрироваться(): bool\n  + предоставитьСправку(): void\n}\n\nclass Медкомиссия {\n  - id: int\n  - номерСправки: string\n  - статусДопуска: bool\n  - датаВыдачи: Date\n  + проверитьСрокДействия(): bool\n}\n\nclass Билет {\n  - id: int\n  - место: string\n  - статус: string\n  + забронировать(): bool\n  + отменить(): bool\n}\n\nclass Тур {\n  - id: int\n  - название: string\n  - стоимость: decimal\n  - датаВылета: Date\n  + получитьИнформацию(): string\n}\n\n&#39; Связи со стрелками и правильным расположением\nКлиент \&quot;1\&quot; -right-&gt; \&quot;0..1\&quot; Медкомиссия : проходит &gt;\nКлиент \&quot;1\&quot; -down-&gt; \&quot;0..*\&quot; Билет : бронирует &gt;\nТур \&quot;1\&quot; -left-&gt; \&quot;1..*\&quot; Билет : содержит &gt;\n\n@endum&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3iKvJdXZhp8h3lEPtXev-1">
